# Copia questo file in ".env" (escluso da Git) se vuoi usare un provider AI online.
# Non inserire mai chiavi API reali in questo file di esempio.

# Provider predefinito: demo | ollama | openai
JARVIS_AI_PROVIDER=demo

# Ollama locale
JARVIS_OLLAMA_URL=http://localhost:11434
JARVIS_OLLAMA_MODEL=

# OpenAI (usato SOLO se selezionato esplicitamente e confermato dall'utente)
OPENAI_API_KEY=
JARVIS_OPENAI_MODEL=gpt-4o-mini
JARVIS_OPENAI_BASE_URL=https://api.openai.com/v1
