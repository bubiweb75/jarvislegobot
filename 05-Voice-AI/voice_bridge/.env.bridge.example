# Copia in .env.bridge (non committare segreti reali!)
JARVIS_BRIDGE_HOST=127.0.0.1
JARVIS_BRIDGE_PORT=8765
JARVIS_BRIDGE_REQUIRE_AUTH=true
JARVIS_BRIDGE_TOKEN=CAMBIA_CON_TOKEN_CASUALE_LUNGO
JARVIS_ESP_DEVICE_TOKEN=CAMBIA_CON_TOKEN_ESP32_LUNGO

# STT (faster-whisper)
JARVIS_STT_MODEL=small
JARVIS_STT_LANGUAGE=it
JARVIS_STT_COMPUTE_TYPE=int8
JARVIS_STT_ALLOW_DOWNLOAD=false
JARVIS_STT_TIMEOUT_S=12.0
JARVIS_STT_BEAM_SIZE=1

# AI Router Ibrido (DISABLED | LOCAL_ONLY | CLOUD_ONLY | LOCAL_FIRST | CLOUD_FIRST)
JARVIS_AI_MODE=DISABLED
JARVIS_AI_FALLBACK_ENABLED=false
JARVIS_AI_TIMEOUT_SECONDS=20.0

# AI Locale: Ollama su PC Windows (solo localhost/127.0.0.1)
JARVIS_OLLAMA_ENABLED=false
JARVIS_OLLAMA_URL=http://127.0.0.1:11434
JARVIS_OLLAMA_MODEL=qwen2.5:3b
JARVIS_OLLAMA_PROBE_TIMEOUT_S=1.5
JARVIS_OLLAMA_CONNECT_TIMEOUT_S=2.0
JARVIS_OLLAMA_GENERATE_TIMEOUT_S=20.0
JARVIS_OLLAMA_MAX_TOKENS=120
JARVIS_OLLAMA_DETAIL_MAX_TOKENS=180
JARVIS_OLLAMA_NUM_CTX=2048
JARVIS_OLLAMA_KEEP_ALIVE=30m
JARVIS_OLLAMA_PREWARM_ON_STARTUP=true
JARVIS_OLLAMA_TEMPERATURE=0.5

# AI Cloud opzionale (HTTPS obbligatorio, disabilitato di default, nessun segreto qui)
JARVIS_CLOUD_ENABLED=false
JARVIS_CLOUD_PROVIDER=openai
JARVIS_CLOUD_BASE_URL=https://api.openai.com/v1
JARVIS_CLOUD_MODEL=gpt-4o-mini
JARVIS_CLOUD_API_KEY=
JARVIS_CLOUD_TIMEOUT_S=20.0
JARVIS_CLOUD_MAX_TOKENS=220
JARVIS_CLOUD_TEMPERATURE=0.5
JARVIS_CLOUD_MAX_REQUESTS_PER_HOUR=30
JARVIS_CLOUD_MAX_DAILY_TOKENS=50000

# TTS (Piper — JARVIS Amichetto)
JARVIS_PIPER_BIN=piper
JARVIS_PIPER_MODEL_PATH=/models/piper/it_IT-riccardo-x_low.onnx
JARVIS_TTS_TIMEOUT_S=10.0
JARVIS_TTS_MAX_CHARS=270
JARVIS_TTS_PIPER_SPEED=1.00
JARVIS_TTS_PIPER_NOISE_SCALE=1.10
JARVIS_TTS_PIPER_PITCH_SEMITONES=5.0
JARVIS_TTS_PIPER_ROBOT_MIX=0.0
JARVIS_TTS_PIPER_DSP_ENABLED=true

# Memoria conversazionale di sessione & sicurezza
JARVIS_CONVERSATION_MAX_MESSAGES=8
JARVIS_CONVERSATION_MAX_TOKENS=1000
JARVIS_MAX_HISTORY_TURNS=4
JARVIS_LOG_CONVERSATION_TEXT=false
JARVIS_LOG_STT_DIAG_TEXT=false
JARVIS_MAX_WAV_BYTES=524288
JARVIS_MAX_AUDIO_DURATION_S=15.0
JARVIS_MAX_CONCURRENT_REQUESTS=2
JARVIS_AUDIO_TTL_S=120.0
