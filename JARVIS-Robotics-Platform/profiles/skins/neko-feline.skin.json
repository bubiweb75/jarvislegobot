{
  "$schema": "../../schemas/skin.schema.json",
  "skin_id": "skin-neko-feline-v1",
  "schema_version": "1.0.0",
  "name": "NEKO Feline — Robotic Cat Eyes",
  "description": "Identità felina a mandorla, con pupille verticali dilatabili e slow blink. Esclusivamente elementi oculari.",
  "author": "JARVIS Platform Team",
  "skin_version": "1.0.0",
  "target_display": {
    "type": "monochrome_1bit",
    "width": 128,
    "height": 64
  },
  "base_geometry": {
    "width": 38.0,
    "height": 32.0,
    "shape_power": 2.4,
    "taper": 0.15,
    "corner_radius": 12.0,
    "spacing_px": 16,
    "pupil": {
      "shape": "slit_vertical",
      "radius": 6.0,
      "catchlight": "double_offset"
    },
    "eyebrows": {
      "offset": 4.5,
      "arch": 2.0,
      "tilt": 2.0
    }
  },
  "visual_behavior_profile_default": "PLAYFUL",
  "expressions": {
    "NEUTRAL": { "render_mode": "parametric", "width": 38.0, "height": 32.0, "shape_power": 2.4, "corner_radius": 12.0, "pupil_radius": 6.0 },
    "HAPPY": { "render_mode": "crescent", "width": 36.0, "height": 22.0, "pupil_radius": 0.0, "brow_offset": 5.5 },
    "CURIOUS": { "render_mode": "parametric", "width": 38.0, "height": 32.0, "left": { "width": 32.0, "height": 28.0 }, "right": { "width": 42.0, "height": 38.0 } },
    "SLEEPY": { "render_mode": "parametric", "width": 36.0, "height": 26.0, "upper_lid_l": 10.0, "upper_lid_r": 10.0, "pupil_radius": 2.5 },
    "LISTENING": { "render_mode": "parametric", "width": 40.0, "height": 38.0, "pupil_radius": 12.0 },
    "THINKING": { "render_mode": "parametric", "width": 35.0, "height": 28.0, "offset_x": 4.0, "offset_y": -2.0, "pupil_dx": 5.0, "pupil_dy": -2.0, "pupil_radius": 4.0 },
    "SPEAKING": { "render_mode": "parametric", "width": 37.0, "height": 32.0, "lower_lid": 3.0, "lower_arch": 4.0, "pupil_radius": 7.0 },
    "SURPRISED": { "render_mode": "parametric", "width": 42.0, "height": 42.0, "pupil_radius": 14.0, "transition_boost": 2.1 },
    "SHY": { "render_mode": "parametric", "width": 32.0, "height": 26.0, "offset_x": -3.0, "offset_y": 3.0, "pupil_dx": -3.0, "pupil_dy": 2.0, "pupil_radius": 4.5 },
    "LOVE": { "render_mode": "heart", "width": 34.0, "height": 34.0, "pupil_radius": 0.0 },
    "WINK": { "render_mode": "parametric", "width": 38.0, "height": 32.0, "left": { "width": 38.0, "height": 32.0 }, "right": { "render_mode": "crescent", "width": 36.0, "height": 24.0 } },
    "CONFUSED": { "render_mode": "parametric", "width": 36.0, "height": 30.0, "left": { "width": 30.0, "height": 26.0 }, "right": { "width": 40.0, "height": 36.0 } },
    "MISCHIEVOUS": { "render_mode": "parametric", "width": 37.0, "height": 30.0, "upper_lid_l": 3.0, "upper_lid_r": 12.0, "brow_tilt": 4.0 },
    "SLEEPING": { "render_mode": "sleeping_lash", "width": 34.0, "height": 20.0, "pupil_radius": 0.0 }
  },
  "motion": {
    "natural_gaze": { "enabled": true, "micro_saccades_enabled": true, "max_offset_x": 12.0, "max_offset_y": 7.0, "suppress_in_listening": true },
    "advanced_blink": { "enabled": true, "close_rate": 10.0, "open_rate": 8.0, "hold_closed_ms": 75, "double_blink_chance_pct": 15 },
    "interpolation": { "algorithm": "exponential_decay", "base_decay_rate": 16.0 }
  },
  "voice_reactivity": { "enabled": true, "target_ocular_element": "pupil_dilation", "max_deviation_px": 5.0, "smoothing_factor": 0.60 },
  "resource_limits": { "max_framebuffer_bytes": 1024, "max_render_time_us": 2700 },
  "fallback": { "fallback_skin_id": "skin-jarvis-original-v3" }
}
