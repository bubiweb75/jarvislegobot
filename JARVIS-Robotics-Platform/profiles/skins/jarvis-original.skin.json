{
  "$schema": "../../schemas/skin.schema.json",
  "skin_id": "skin-jarvis-original-v3",
  "schema_version": "1.0.0",
  "name": "JARVIS Original Premium — Organic Visor Companion",
  "description": "Baseline grafica ufficiale Eyes 3.0. Geometrie superellittiche organiche 38x38 px, 14 espressioni e micro-espressioni.",
  "author": "JARVIS Platform Team",
  "skin_version": "3.0.0",
  "target_display": {
    "type": "monochrome_1bit",
    "width": 128,
    "height": 64
  },
  "base_geometry": {
    "width": 38.0,
    "height": 38.0,
    "shape_power": 2.6,
    "taper": 0.10,
    "corner_radius": 11.0,
    "spacing_px": 16,
    "pupil": {
      "shape": "circle",
      "radius": 7.0,
      "catchlight": "double_offset"
    },
    "eyebrows": {
      "offset": 4.0,
      "arch": 2.2,
      "tilt": 0.0
    }
  },
  "visual_behavior_profile_default": "LIVELY",
  "expressions": {
    "NEUTRAL": {
      "render_mode": "parametric",
      "width": 38.0,
      "height": 38.0,
      "shape_power": 2.6,
      "taper": 0.10,
      "corner_radius": 11.0,
      "pupil_radius": 7.0
    },
    "HAPPY": {
      "render_mode": "crescent",
      "width": 36.0,
      "height": 24.0,
      "pupil_radius": 0.0,
      "brow_offset": 6.0,
      "brow_arch": 3.5
    },
    "CURIOUS": {
      "render_mode": "parametric",
      "width": 38.0,
      "height": 38.0,
      "left": { "width": 30.0, "height": 28.0, "upper_lid_l": 2.0, "upper_lid_r": 7.0, "brow_tilt": 2.5 },
      "right": { "width": 42.0, "height": 42.0, "brow_tilt": -2.5 }
    },
    "SLEEPY": {
      "render_mode": "parametric",
      "width": 36.0,
      "height": 30.0,
      "upper_lid_l": 11.0,
      "upper_lid_r": 11.0,
      "upper_arch": 2.0,
      "pupil_radius": 5.0,
      "pupil_dy": 3.0
    },
    "LISTENING": {
      "render_mode": "parametric",
      "width": 38.0,
      "height": 42.0,
      "shape_power": 2.4,
      "pupil_radius": 8.5,
      "brow_offset": 5.5
    },
    "THINKING": {
      "render_mode": "parametric",
      "width": 35.0,
      "height": 31.0,
      "offset_x": 4.0,
      "offset_y": -3.0,
      "upper_lid_l": 8.0,
      "upper_lid_r": 5.0,
      "pupil_dx": 5.5,
      "pupil_dy": -3.0,
      "pupil_radius": 5.5
    },
    "SPEAKING": {
      "render_mode": "parametric",
      "width": 37.0,
      "height": 35.0,
      "lower_lid": 4.0,
      "lower_arch": 6.0,
      "pupil_radius": 6.5
    },
    "SURPRISED": {
      "render_mode": "parametric",
      "width": 39.0,
      "height": 45.0,
      "shape_power": 2.1,
      "pupil_radius": 3.5,
      "transition_boost": 1.85
    },
    "SHY": {
      "render_mode": "parametric",
      "width": 32.0,
      "height": 28.0,
      "offset_x": -3.0,
      "offset_y": 4.0,
      "pupil_dx": -4.0,
      "pupil_dy": 2.5,
      "pupil_radius": 6.0,
      "brow_tilt": -3.5
    },
    "LOVE": {
      "render_mode": "heart",
      "width": 34.0,
      "height": 34.0,
      "pupil_radius": 0.0
    },
    "WINK": {
      "render_mode": "parametric",
      "width": 38.0,
      "height": 38.0,
      "left": { "width": 38.0, "height": 38.0 },
      "right": { "render_mode": "crescent", "width": 36.0, "height": 26.0 }
    },
    "CONFUSED": {
      "render_mode": "parametric",
      "width": 35.0,
      "height": 35.0,
      "left": { "width": 31.0, "height": 27.0, "upper_lid_l": 8.0, "brow_tilt": 3.5 },
      "right": { "width": 40.0, "height": 40.0, "brow_tilt": -3.5 }
    },
    "MISCHIEVOUS": {
      "render_mode": "parametric",
      "width": 37.0,
      "height": 32.0,
      "upper_lid_l": 2.0,
      "upper_lid_r": 14.0,
      "lower_arch": 7.0,
      "brow_tilt": 4.5
    },
    "SLEEPING": {
      "render_mode": "sleeping_lash",
      "width": 34.0,
      "height": 24.0,
      "pupil_radius": 0.0
    }
  },
  "motion": {
    "natural_gaze": {
      "enabled": true,
      "micro_saccades_enabled": true,
      "max_offset_x": 11.0,
      "max_offset_y": 6.0,
      "suppress_in_listening": true
    },
    "advanced_blink": {
      "enabled": true,
      "close_rate": 18.0,
      "open_rate": 14.0,
      "hold_closed_ms": 42,
      "double_blink_chance_pct": 20
    },
    "interpolation": {
      "algorithm": "exponential_decay",
      "base_decay_rate": 16.0
    }
  },
  "voice_reactivity": {
    "enabled": true,
    "target_ocular_element": "lower_eyelid_arch",
    "max_deviation_px": 4.0,
    "smoothing_factor": 0.65
  },
  "resource_limits": {
    "max_framebuffer_bytes": 1024,
    "max_render_time_us": 2800
  },
  "fallback": {
    "fallback_skin_id": "skin-jarvis-original-v3"
  }
}
