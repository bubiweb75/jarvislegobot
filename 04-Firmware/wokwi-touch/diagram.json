{
  "version": 1,
  "author": "JARVIS LEGO BOT (FASE 11.1 - Touch)",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-s3-devkitc-1",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": {
        "flashSize": "16",
        "psramType": "octal"
      }
    },
    {
      "type": "board-ssd1306",
      "id": "oled1",
      "top": -140,
      "left": 210,
      "attrs": {
        "i2cAddress": "0x3c"
      }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn1",
      "top": 115,
      "left": 220,
      "attrs": {
        "color": "blue",
        "key": "Space",
        "label": "BTN GPIO47"
      }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn_touch",
      "top": 205,
      "left": 220,
      "attrs": {
        "color": "green",
        "key": "t",
        "label": "TOUCH GPIO1"
      }
    },
    {
      "type": "wokwi-resistor",
      "id": "r_touch",
      "top": 245,
      "left": 140,
      "attrs": {
        "value": "10000"
      }
    }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],
    [ "oled1:GND", "esp:GND.1", "black", [ "v0" ] ],
    [ "oled1:VCC", "esp:3V3.1", "red", [ "v0" ] ],
    [ "oled1:SDA", "esp:41", "blue", [ "v0" ] ],
    [ "oled1:SCL", "esp:42", "green", [ "v0" ] ],
    [ "btn1:1.l", "esp:47", "orange", [ "h-20" ] ],
    [ "btn1:2.l", "esp:GND.2", "black", [ "h-20" ] ],
    [ "btn_touch:1.l", "esp:1", "yellow", [ "h-20" ] ],
    [ "btn_touch:2.r", "esp:3V3.2", "red", [ "h20" ] ],
    [ "r_touch:1", "btn_touch:1.l", "yellow", [ "h0" ] ],
    [ "r_touch:2", "esp:GND.3", "black", [ "h0" ] ]
  ],
  "serialMonitor": {
    "display": "auto",
    "newline": "lf"
  },
  "dependencies": {}
}
